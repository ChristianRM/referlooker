# Configuración de claves sensibles para referral_bot
# Copia este archivo como '.env' en el mismo directorio y llena tus credenciales.
# El archivo '.env' está ignorado en Git para tu seguridad.

# Google Custom Search API Key (Opción A)
GOOGLE_API_KEY=your_google_api_key_here

# Google Custom Search Engine ID / CX (Opción A)
GOOGLE_CX=your_google_cx_id_here

# SerpAPI Key (Opción B)
SERPAPI_KEY=your_serpapi_key_here
